# MATLAB autosave files
*.asv

# MATLAB temporary files
*.m~

# Simulink autosave files
*.autosave
*.slxc

# Simulink cache files
slprj/
*.slxc

# Code generation folders
codegen/

# MATLAB compiled files (MEX)
*.mex*
*.mexw64
*.mexw32
*.mexa64
*.mexmaci64
*.mexmaca64

# MATLAB App Designer generated files
*.mlapp~

# MATLAB temporary variables
matlab_crash_dump.*

# Profiler output
profile_results/

# Build artifacts
*.o
*.obj

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor backup files
*~
*.swp
*.swo


# Keep the results/ directory scaffold tracked (but not its heavy contents)
!results/
!results/**/
!**/.gitkeep

# New revalidated scientific runs (immutable per-run directories)
results/revalidated/**
!results/revalidated/
!results/revalidated/.gitkeep

# Exception: publication figures are committed for reproducibility/sharing
!results/figures/paper/
!results/figures/paper/*.png
!results/figures/paper/*.pdf

